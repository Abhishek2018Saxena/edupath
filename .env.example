# EduPath — n8n Webhook Configuration
#
# Paste your n8n PRODUCTION webhook URL below in your local .env file.
# This is the public webhook URL exposed by your n8n instance that EduPath
# will POST the resume PDF + target role to.
#
# Example:
#   VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/edupath-analyze
#
# Leave this BLANK to run the app in demo mode (mock data will be shown).
# Do NOT commit your real .env file — only this .env.example template.

VITE_N8N_WEBHOOK_URL=
